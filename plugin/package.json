{
  "name": "@jakedowns/progress-tool-opencode-plugin",
  "version": "2.14.0",
  "description": "OpenCode plugin: native progress indicators for the TUI and desktop GUI, with an out-of-band relay for zero-token long-running command telemetry",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "node --test test/dismissal.test.cjs test/instructions.test.cjs test/monitor.test.cjs test/skills.test.cjs test/telemetry.test.cjs",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@jakedowns/progress-tool-mcp": "^2.8.0",
    "@opencode/plugin": "^2.3.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Jake Downs <mail@jakedowns.com>",
  "homepage": "https://github.com/jakedowns/progress-tool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakedowns/progress-tool.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/jakedowns/progress-tool/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "progress",
    "progress-bar",
    "mcp",
    "relay",
    "telemetry",
    "osc-9-4"
  ]
}
