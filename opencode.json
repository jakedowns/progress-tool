{
  "experimental": {
    "plugin_gui_web": ["opencode-progress"]
  },
  "mcp": {
    "servers": {
      "progress-server": {
        "type": "local",
        "command": ["node", "mcp-server/index.js"],
        "environment": {
          "PROGRESS_TASKLIST": "1",
          "PROGRESS_TASKLIST_LOCATION": "1",
          "PROGRESS_TASKLIST_MODE": "raw",
          "PROGRESS_TASKLIST_DETAIL": "code",
          "PROGRESS_TASKLIST_ORDER": "newest-first"
        }
      }
    }
  }
}
